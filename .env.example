# Copy to .env and fill in. This file is read by docker compose and never goes into git when named .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=backup.example.com
CSRF_TRUSTED_ORIGINS=https://backup.example.com
# 1 when nginx (or any single reverse proxy) is in front: real client IP from X-Forwarded-For, https redirect
TRUSTED_PROXY_COUNT=1
# Only after https works: seconds a browser must insist on https (try 3600 first, later 31536000)
# DJANGO_HSTS_SECONDS=3600

# --- where the backup containers are ---
# Portainer: every Docker environment the token can see becomes a server in the panel
PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=ptr_xxxxxxxx
# PORTAINER_ENVIRONMENTS=vps-1,vps-2
# Docker on this very host, through the socket-proxy service (start compose with --profile proxy)
# DOCKER_ENDPOINTS=local=tcp://socket-proxy:2375

# --- network ---
# PANEL_BIND=127.0.0.1
# PANEL_PORT=8000

# --- optional ---
# JOB_TIMEOUT=3600
# AXES_FAILURE_LIMIT=5
# TIME_ZONE=Asia/Jakarta
