# nginx in front of odoo-backup-panel. This panel is the equivalent of root on every server it manages,
# so it is reachable only from addresses you list here (and the panel's own port only from this nginx).
server {
    listen 80;
    server_name backup.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name backup.example.com;
    ssl_certificate     /etc/letsencrypt/live/backup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backup.example.com/privkey.pem;

    # Who may open the panel at all. Everyone else gets a 403 from nginx, before any login page.
    allow 203.0.113.10;     # office
    allow 198.51.100.0/24;  # VPN
    deny  all;

    # Add HSTS here once https works: add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8000;          # or the private address of the host running the panel
        proxy_set_header Host $host;
        # Appends the client address as the LAST entry, which is what TRUSTED_PROXY_COUNT=1 reads.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Backups are downloaded as a stream: do not buffer a zip of hundreds of MB to disk first.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
